# Splitpage document server — settings.
#
# On the server this file is copied to .env beside deploy.sh:
#
#   cd /mnt/user/appdata/splitpage
#   cp .env.example .env
#   chmod 600 .env
#
# then JOIN_PIN is filled in (DEPLOY.md, First-time setup, step 3 does it
# with one command). deploy.sh hands the finished .env to the container and
# REFUSES to run while JOIN_PIN, PERSIST_LINKS or TRUST_PROXY are missing or
# wrong.
#
# How to write a line — docker reads this file, and it is stricter than a
# shell:
#   - NAME=value, nothing else on the line. No spaces around "=".
#   - No quotes. Docker keeps them as part of the value.
#   - No comment after a value. A comment is a line of its own starting "#".
#   - Each setting once.
#
# Changing this file does nothing until the server restarts:
#   docker restart splitpage
#
# Never commit .env or paste it anywhere: JOIN_PIN is the key to every script
# on the server. (.gitignore and .dockerignore both keep it out of git and out
# of the image.)


# ---- required ----

# The OWNER KEY. Whoever types it into Splitpage (Collaborate) can do
# everything: open, change and delete every script, and make or turn off
# invite links. It is the lock on the server — there is no Cloudflare Access
# in front of it — so it must be long and random: deploy.sh refuses anything
# under 20 characters.
#
# Letters and digits only, so nothing in it can confuse this file's format.
# Generate one on the server with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
# and keep a copy in your password manager.
#
# Changing it signs every device out (each types the new key once); invite
# links you have already sent keep working.
JOIN_PIN=

# 1 = remember invite links, and devices signed in with the owner key,
# across restarts and deploys. Exactly 1: anything else means off, and every
# link you had sent would stop working on the next restart. They are kept in
# data/links/, beside the scripts, and backed up with them: links.json (the
# links you've made — lose it and every sent link is dead) and secret (lose
# it and every device has to sign in with the owner key again).
PERSIST_LINKS=1

# cloudflare = count wrong owner-key guesses per visitor using the address
# Cloudflare puts in the Cf-Connecting-Ip header. Behind the tunnel every
# request reaches the server from the same address, so without this one
# stranger's wrong guesses lock everyone out. Do NOT use TRUST_PROXY=1 here:
# that trusts X-Forwarded-For, which any visitor can fill in through
# Cloudflare, and a guesser could then dodge the limit.
#
# Cloudflare sets Cf-Connecting-Ip itself, so it can't be forged THROUGH the
# tunnel — but anything reaching port 8791 directly can write whatever it
# likes in it. Fine from your own home network, with a long owner key; never
# forward 8791 on your router.
TRUST_PROXY=cloudflare

# Other web pages allowed to call this server, comma-separated.
# splitpage://app is the Splitpage desktop app: without it the desktop app
# cannot connect (browsers opening https://script.bigmanonline.uk don't need
# an entry — they are the server's own page). Entries must match exactly;
# `null` is ignored on purpose.
ALLOW_ORIGINS=splitpage://app


# ---- optional: limits (the defaults are fine) ----

# Largest script one save may send, in bytes. Default 25 MiB.
#MAX_BODY_BYTES=26214400

# Largest single image, in bytes. Default 8 MiB. Only PNG, JPEG, GIF and WebP
# are accepted, whatever this says.
#MAX_BLOB_BYTES=8388608

# How many bytes of images someone on a Can-comment link may upload per
# rolling hour (screenshots pasted into comments). Default 20 MiB.
#REVIEW_BLOB_BUDGET_BYTES=20971520

# How many bytes of images someone on a Can-edit link may upload per rolling
# hour. Default 100 MiB. You, signed in with the owner key, are not limited.
#LINK_EDIT_BLOB_BUDGET_BYTES=104857600

# 1 = nobody can change anything, the owner included: a library to read.
#READ_ONLY=0


# ---- not for this setup ----
#
# PORT, HOST, DATA_DIR, STATIC_DIR — set by the image to match the container.
#   deploy.sh refuses to run if .env sets any of them (a DATA_DIR here would
#   put your scripts inside the container, where the next deploy deletes
#   them). The port the tunnel reaches is PORT at the top of deploy.sh.
# REVIEW_PIN, REVIEW_KEY — one comment-only code for the WHOLE library, from
#   the laptop launcher. Per-script invite links do this job better; leave
#   them unset.
