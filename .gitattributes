# Normalise to LF in the repository, so what the build and release zip copy
# does not depend on which machine committed it.
* text=auto eol=lf

*.sh text eol=lf

# Windows-only launchers: cmd.exe wants CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary-ish assets, never line-ending mangled.
*.png binary
*.jpg binary
*.ico binary

src/test/** linguist-detectable=false
tests/** linguist-detectable=false
desktop/test/** linguist-detectable=false
*.test.ts linguist-detectable=false
*.test.mjs linguist-detectable=false
tools/test-*.mjs linguist-detectable=false
