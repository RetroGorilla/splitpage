#!/bin/sh
# Refuse to commit index.html if it carries a real script instead of the demo.
#
# Splitpage keeps the whole document inside the page — one line of JSON in the
# <script id="state-data"> tag (see HANDOFF.md §3.1). Saving a project into
# THIS file therefore rewrites a tracked file with your script in it, and
# committing that would push unreleased work to GitHub and replace the clean
# template everyone else clones.
#
# So: the committed index.html must always carry the demo document, byte for
# byte. Code changes are none of this hook's business — only that one line.

set -e

# --- index.html is generated from src/ -------------------------------------
#
# Since the refactor, src/page.html + src/app.css + src/app.js + src/seed-state.json
# are the source and index.html is the build output (build.mjs inlines them
# back into one self-contained page, which the save format requires — see
# HANDOFF.md). Hand-editing index.html therefore looks like it works and is
# thrown away by the next build, so a commit where the two disagree is always
# a mistake. Checked against STAGED content, which is what is being committed.
# VERSION is a build input too (build.mjs splices it into index.html's
# {{VERSION}} marker) — a commit that bumps only VERSION, staging no other
# file, used to skip this whole check, letting a stale-version index.html
# through undetected. README.md became a build input in Phase 5 (the in-app
# Help page is rendered from it at build time), so it needs the same check.
if git diff --cached --name-only | grep -qE '^(index\.html|src/|build\.mjs|VERSION|README\.md)'; then
  if [ "$SPLITPAGE_SKIP_BUILD_CHECK" = "1" ]; then
    echo "pre-commit: build check skipped (SPLITPAGE_SKIP_BUILD_CHECK=1)." >&2
  elif ! command -v node >/dev/null 2>&1; then
    cat >&2 <<'NONODE'

  COMMIT BLOCKED — Node is not installed, so index.html cannot be verified.

  index.html is built from src/ by `node build.mjs`. Without Node this commit
  could ship an index.html that no longer matches the source it claims to be
  built from. Install Node 18+ (nodejs.org), then commit again.

  To commit anyway, knowing index.html may be stale:

      SPLITPAGE_SKIP_BUILD_CHECK=1 git commit ...

NONODE
    exit 1
  else
    # Export exactly what is staged and build that, so an unbuilt working tree
    # neither masks a stale commit nor causes a false alarm.
    STAGE_DIR=$(mktemp -d)
    trap 'rm -rf "$STAGE_DIR"' EXIT
    git checkout-index -a --prefix="$STAGE_DIR/"
    if ! (cd "$STAGE_DIR" && node build.mjs --check >/dev/null 2>&1); then
      cat >&2 <<'STALE'

  COMMIT BLOCKED — index.html does not match src/.

  index.html is generated. Either you edited it directly (those edits belong
  in src/ and will be lost), or you changed src/ and did not rebuild.

  To fix:

      node build.mjs && git add index.html

STALE
      exit 1
    fi
    rm -rf "$STAGE_DIR"; trap - EXIT
  fi
fi

# Nothing to check unless index.html is part of this commit.
if ! git diff --cached --name-only | grep -qx 'index.html'; then
  exit 0
fi

BASE=".githooks/demo-state.json"
if [ ! -f "$BASE" ]; then
  echo "pre-commit: $BASE is missing — cannot verify the embedded document." >&2
  echo "            Restore it, or delete this hook if that is deliberate." >&2
  exit 1
fi

# Read the STAGED version, not the working tree: what is being committed is
# what matters, and the two can differ.
#
# Anchored to ^ deliberately. That same tag string also appears INSIDE the
# app's JavaScript (buildPublishHtml's openTag), indented — matching it would
# read the wrong line. The document's own tag is the only one at column 0.
STAGED_STATE=$(git show :index.html | awk '/^<script id="state-data"/{getline; print; exit}')

if [ -z "$STAGED_STATE" ]; then
  echo "pre-commit: could not find the state-data line in the staged index.html." >&2
  echo "            If the page structure changed deliberately, update this hook." >&2
  exit 1
fi

if [ "$STAGED_STATE" = "$(cat "$BASE")" ]; then
  exit 0
fi

# --- blocked ---------------------------------------------------------------
STAGED_BYTES=$(printf '%s' "$STAGED_STATE" | wc -c | tr -d ' ')
DEMO_BYTES=$(wc -c < "$BASE" | tr -d ' ')
TITLE=$(printf '%s' "$STAGED_STATE" | sed -n 's/.*"title":"\([^"]*\)".*/\1/p')

cat >&2 <<EOF

  COMMIT BLOCKED — index.html has a document in it that isn't the demo.

  Embedded document: ${STAGED_BYTES} bytes (the demo is ${DEMO_BYTES})
  Title:             ${TITLE:-unknown}

  You have almost certainly saved a script into the app's own index.html.
  Committing it would push that script to GitHub and replace the clean
  template. Your script is safe on disk either way — this only stops it
  being committed.

  To fix, putting the demo document back and keeping any code changes:

      sh .githooks/restore-demo-state.sh && git add index.html

  Then save your actual script somewhere outside this repo — /d/vibecoding/scripts
  is there for exactly that — and open it from there in future.

  If you genuinely meant to change the demo document that ships with the app:

      cp src/seed-state.json .githooks/demo-state.json
      git add .githooks/demo-state.json src/seed-state.json index.html

EOF
exit 1
