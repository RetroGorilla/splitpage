FROM node:24-alpine

ENV NODE_ENV=production \
    PORT=8791 \
    HOST=0.0.0.0 \
    STATIC_DIR=/app/public

WORKDIR /app

COPY index.html manifest.webmanifest icon.svg icon-maskable.svg sw.js ./public/
COPY VERSION ./
COPY server/ ./server/

USER node
EXPOSE 8791

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "require('node:http').get({host:'127.0.0.1',port:process.env.PORT,path:'/',timeout:4000},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "server/server.js"]
