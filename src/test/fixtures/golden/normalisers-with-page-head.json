      }
    ],
    "output": "<!doctype html><html><head><meta charset=\"utf-8\"><title>&lt;b&gt;&amp;&quot;'</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>"
  },
  {
    "case": "replacement patterns are literal",
