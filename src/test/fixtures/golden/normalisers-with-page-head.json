      "<!doctype html><html><head><meta charset=\"utf-8\"><title>Old</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>",
      {
        "title": "New"
      }
    ],
    "output": "<!doctype html><html><head><meta charset=\"utf-8\"><title>New</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>"
  },
  {
    "case": "a title's whitespace collapsed and trimmed",
    "input": [
      "<!doctype html><html><head><meta charset=\"utf-8\"><title>Old</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>",
      {
        "title": " New \n\t title  "
      }
    ],
    "output": "<!doctype html><html><head><meta charset=\"utf-8\"><title>New title</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>"
  },
  {
    "case": "NBSP and a line separator count as whitespace",
    "input": [
      "<!doctype html><html><head><meta charset=\"utf-8\"><title>Old</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>",
      {
        "title": " New title "
      }
    ],
    "output": "<!doctype html><html><head><meta charset=\"utf-8\"><title>New title</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>"
  },
  {
    "case": "a title escaped",
    "input": [
      "<!doctype html><html><head><meta charset=\"utf-8\"><title>Old</title><meta name=\"description\" content=\"old\"></head><body><p>x</p></body></html>",
