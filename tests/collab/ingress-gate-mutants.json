{
  "tests": ["tests/adapters/collab/ingress-gate.test.ts", "tests/adapters/collab/ingress-gate-generator.test.ts"],
  "mutants": [{
    "label": "gate not reopened after a throw",
    "file": "src/adapters/collab/state.ts",
    "find": "catch (error) { if (!failure.recorded || !Object.is(failure.error, error)) gate.errors.push(error); }",
    "replace": "catch (error) { gate.frames = 0; throw error; }"
  }, {
    "label": "drain stopped by a throw",
    "file": "src/adapters/collab/state.ts",
    "find": "      catch (error) { gate.errors.push(error); }",
    "replace": "      catch (error) { gate.errors.push(error); break; }"
  }, {
    "label": "arrival during the drain applied at once",
    "file": "src/adapters/collab/state.ts",
    "find": "      gate.holds.add(\"delivering\");\n      try { runCollabTransaction",
    "replace": "      gate.frames = 0;\n      try { runCollabTransaction"
  }, {
    "label": "local write during a notification allowed",
    "file": "src/adapters/collab/state.ts",
    "find": "if (state.execution && state.execution !== execution || state.ingress.holds.has(\"delivering\")) throw new SharedExecutionWriteError();",
    "replace": "if (state.execution && state.execution !== execution) throw new SharedExecutionWriteError();"
  }, {
    "label": "callback error thrown into the library's cleanup",
    "file": "src/adapters/collab/state.ts",
    "find": "      gate.errors.push(error);",
    "replace": "      throw error;"
  }, {
    "label": "held update applied out of arrival order",
    "file": "src/adapters/collab/document.ts",
    "find": "gate.held.push(Uint8Array.from(update));",
    "replace": "gate.held.unshift(Uint8Array.from(update));"
  }, {
    "label": "update inside another write joins its transaction",
    "file": "src/adapters/collab/document.ts",
    "find": "const closed = gate.holds.size > 0 || gate.frames > 0 && !state.execution;",
    "replace": "const closed = gate.holds.size > 0;"
  }, {
    "label": "held updates survive destroy",
    "file": "src/adapters/collab/document.ts",
    "find": "  state.ingress.held.length = 0;",
    "replace": "  void 0;"
  }, {
    "label": "gate reason mistaken for notification phase",
    "file": "src/adapters/collab/state.ts",
    "find": "if (state.execution && (state.execution.applying || !state.ingress.notifications)) throw new SharedExecutionWriteError();",
    "replace": "if (state.execution && !state.ingress.holds.has(\"delivering\")) throw new SharedExecutionWriteError();",
    "tests": ["tests/adapters/collab/execution-guard.test.ts"]
  }]
}
