{
  "tests": [
    "src/test/shared-split-app.test.mjs"
  ],
  "mutants": [
    {
      "label": "Split does not pass its abandonment registry",
      "file": "src/bootstrap/wiring/shared-split.ts",
      "find": "stamps: sessionStamps, abandonment,",
      "replace": "stamps: sessionStamps,"
    },
    {
      "label": "Split ordinary abandonment never runs its surfaces",
      "file": "src/bootstrap/wiring/shared-split.ts",
      "find": "abandon: () => { closing = true; abandonAll(false); },",
      "replace": "abandon: () => { closing = true; },"
    },
    {
      "label": "Split final abandonment is only ordinary abandonment",
      "file": "src/bootstrap/wiring/shared-split.ts",
      "find": "drop: () => { closing = true; abandonAll(true); },",
      "replace": "drop: () => { closing = true; abandonAll(false); },"
    },
    {
      "label": "Split abandonment retains disposed registrations",
      "file": "src/bootstrap/wiring/shared-split.ts",
      "find": "return () => { abandons.delete(abandon); };",
      "replace": "return () => {};"
    },
    {
      "label": "Split ordinary abandon discards committable text",
      "file": "src/bootstrap/wiring/split-buffer.ts",
      "find": "if (final || !binding.finish()) abandon(final);",
      "replace": "abandon(final);"
    },
    {
      "label": "Split field loses final abandonment",
      "file": "src/bootstrap/wiring/split-buffer.ts",
      "find": "if (final || !binding.finish()) abandon(final);",
      "replace": "if (final || !binding.finish()) abandon(false);"
    },
    {
      "label": "Split field never registers for abandonment",
      "file": "src/bootstrap/wiring/split-buffer.ts",
      "find": "abandonment: abandon => shared.bufferedText.abandonment?.(final => {\n            if (final || !binding.finish()) abandon(final);\n          }) ?? (() => {})",
      "replace": "abandonment: () => () => {}"
    }
  ]
}
