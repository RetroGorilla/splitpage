    {
      "rule": "platform-global",
      "source": "shared/video-embed.js",
      "target": "global:clearTimeout"
    },
    {
      "rule": "platform-global",
      "source": "shared/video-embed.js",
      "target": "global:setTimeout"
    },
    {
      "rule": "platform-global",
      "source": "shared/video-embed.js",
      "target": "global:TextDecoder"
    },
    {
      "rule": "platform-global",
      "source": "shared/video-embed.js",
