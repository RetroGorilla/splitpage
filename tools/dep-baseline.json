    },
    {
      "rule": "unresolved-dynamic",
      "source": "desktop/main.js",
      "target": "require(path.join(SHARED_ROOT, \"history-policy.js\"))"
    },
    {
      "rule": "unresolved-dynamic",
      "source": "desktop/main.js",
      "target": "require(path.join(SHARED_ROOT, \"history-store.js\"))"
    },
    {
      "rule": "unresolved-dynamic",
      "source": "desktop/main.js",
      "target": "require(path.join(SHARED_ROOT, \"video-embed.js\"))"
    },
    {
      "rule": "unresolved-dynamic",
      "source": "desktop/test/verify-dist-payload.test.mjs",
      "target": "import( pathToFileURL(path.join(here, \"..\", \"verify-dist-payload.mjs\")) )"
    },
    {
      "rule": "unresolved-dynamic",
